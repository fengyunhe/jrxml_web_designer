# AI服务配置
# 默认使用LMStudio本地接口

# AI服务地址（默认LMStudio本地接口）
VITE_AI_API_ENDPOINT=http://127.0.0.1:1234/v1

# API密钥（本地模型可使用默认值）
VITE_AI_API_KEY=lm-studio

# 模型名称（LMStudio会自动检测）
VITE_AI_MODEL_NAME=local-model

# Token限制（根据模型调整）
VITE_AI_MAX_TOKENS=4096

# 温度参数（0.0-1.0，越高越随机）
VITE_AI_TEMPERATURE=0.7

# ============================================================
# 其他AI服务配置示例
# ============================================================

# Ollama本地接口
# VITE_AI_API_ENDPOINT=http://localhost:11434/v1
# VITE_AI_API_KEY=ollama
# VITE_AI_MODEL_NAME=llama2

# OpenAI API
# VITE_AI_API_ENDPOINT=https://api.openai.com/v1
# VITE_AI_API_KEY=your-openai-api-key
# VITE_AI_MODEL_NAME=gpt-4

# Claude API（需要Anthropic的OpenAI兼容层）
# VITE_AI_API_ENDPOINT=https://api.anthropic.com/v1
# VITE_AI_API_KEY=your-anthropic-api-key
# VITE_AI_MODEL_NAME=claude-3-sonnet-20240229

# 其他兼容API
# VITE_AI_API_ENDPOINT=https://your-ai-service.com/v1
# VITE_AI_API_KEY=your-api-key
# VITE_AI_MODEL_NAME=your-model-name
