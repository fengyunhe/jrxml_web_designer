<?xml version="1.0" encoding="UTF-8"?>
<jasperReport xmlns="http://jasperreports.sourceforge.net/jasperreports" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:schemaLocation="http://jasperreports.sourceforge.net/jasperreports http://jasperreports.sourceforge.net/xsd/jasperreport.xsd" name="test_border_zero_width" pageWidth="595" pageHeight="842">
  <title>
    <band height="100">
      <!-- 所有方向的lineWidth都为0 -->
      <staticText>
        <reportElement x="20" y="20" width="200" height="30"/>
        <box>
          <topPen lineWidth="0" lineStyle="Solid" lineColor="#000000"/>
          <leftPen lineWidth="0" lineStyle="Solid" lineColor="#000000"/>
          <bottomPen lineWidth="0" lineStyle="Solid" lineColor="#000000"/>
          <rightPen lineWidth="0" lineStyle="Solid" lineColor="#000000"/>
        </box>
        <textElement>
          <font fontName="Arial" size="12"/>
        </textElement>
        <text><![CDATA[无边框文本]]></text>
      </staticText>
      
      <!-- 部分方向的lineWidth为0 -->
      <staticText>
        <reportElement x="20" y="60" width="200" height="30"/>
        <box>
          <topPen lineWidth="1" lineStyle="Solid" lineColor="#000000"/>
          <leftPen lineWidth="0" lineStyle="Solid" lineColor="#000000"/>
          <bottomPen lineWidth="1" lineStyle="Solid" lineColor="#000000"/>
          <rightPen lineWidth="0" lineStyle="Solid" lineColor="#000000"/>
        </box>
        <textElement>
          <font fontName="Arial" size="12"/>
        </textElement>
        <text><![CDATA[部分边框文本]]></text>
      </staticText>
    </band>
  </title>
</jasperReport>